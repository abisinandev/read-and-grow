<!-- Navbar for signed-out visitors. Deliberately does NOT mirror navBar.ejs's
     Shop/Wishlist/Cart/Account icon row — every one of those routes requires a login in
     this app, so showing them to a guest just means every icon pops a "please login"
     prompt on click, which reads as broken functionality rather than what it actually is.
     A clear Login / Sign up pair says the same thing honestly. -->
<nav class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row items-center justify-between h-auto sm:h-16 py-4 sm:py-0">
            <!-- Logo -->
            <a href="/" class="flex items-center mb-4 sm:mb-0">
                <h1 class="text-xl sm:text-2xl font-bold text-gray-900">REad & GroW</h1>
            </a>

            <!-- Search Bar -->
            <div class="flex-1 w-full sm:max-w-2xl px-0 sm:px-6 mb-4 sm:mb-0">
                <div class="relative">
                    <form id="guestSearchForm">
                        <input type="search"
                               name="query"
                               placeholder="Search for books..."
                               class="w-full px-4 py-2 rounded-full border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm sm:text-base"
                               aria-label="Search">
                        <button type="submit"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                                aria-label="Submit search">
                            <i class="fas fa-search text-sm sm:text-base"></i>
                        </button>
                    </form>
                    <script>
                        document.getElementById('guestSearchForm').addEventListener('submit', (e) => {
                            e.preventDefault();
                            pleaseLogin();
                        });
                    </script>
                </div>
            </div>

            <!-- Account actions -->
            <div class="flex items-center space-x-4 sm:space-x-6">
                <a href="/login" class="text-sm sm:text-base font-medium text-gray-600 hover:text-gray-900 transition-colors duration-200">
                    Login
                </a>
                <a href="/signup" class="text-sm sm:text-base font-medium bg-black text-white px-4 py-2 rounded-lg hover:bg-gray-800 transition-colors duration-200">
                    Sign Up
                </a>
            </div>
        </div>
    </div>
</nav>
