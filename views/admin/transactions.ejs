<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transaction Management - Read & Grow</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      .table-container { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    </style>
</head>
<body class="bg-gray-50 font-sans min-h-screen flex flex-col md:flex-row">
    <!-- Sidebar -->
    <%- include("../partials/admin/adminSideBar.ejs") %>

    <!-- Main Content -->
    <div class="p-4 pt-20 md:pt-6 sm:p-6 md:pt-6 flex-1 min-w-0">
        <%- include("../partials/admin/breadcrumb.ejs", { breadcrumbs: [{ label: 'Transactions' }] }) %>
        <header class="bg-white shadow-sm rounded-xl mb-6">
            <div class="flex justify-between items-center px-6 py-4">
                <h1 class="text-2xl font-semibold text-gray-800">Transaction Management</h1>
            </div>
        </header>

        <div class="bg-white rounded-xl shadow-sm p-6">
            <!-- Header -->
            <div class="flex flex-col sm:flex-row flex-wrap justify-between items-center mb-6 gap-4">
                <div>
                    <h2 class="text-xl font-semibold text-gray-800">Transactions</h2>
                    <p class="text-gray-500 text-sm mt-0.5">Wallet credits and debits across all users</p>
                </div>
                <div class="flex flex-col sm:flex-row flex-wrap items-center gap-4 w-full sm:w-auto">
                    <form id="searchForm" class="flex flex-col sm:flex-row flex-wrap items-center gap-4 w-full sm:w-auto">
                        <div class="relative w-full sm:w-72">
                            <input type="text" name="searchInput" value="<%= typeof query !== 'undefined' ? query : '' %>"
                                placeholder="Search by transaction ID, username or email"
                                class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg w-full focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                        </div>
                        <button type="submit"
                            class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition duration-150 w-full sm:w-auto">Search</button>
                    </form>
                    <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition duration-150 w-full sm:w-auto"
                        onclick="window.location.href='/admin/transactions'">Reset</button>
                </div>
            </div>

            <!-- Transactions Table -->
            <div class="table-container">
                <table class="w-full min-w-[760px]">
                    <thead>
                        <tr class="bg-gray-100 text-gray-600 uppercase text-xs font-semibold tracking-wider">
                            <th class="px-4 py-3 text-left">Transaction ID</th>
                            <th class="px-4 py-3 text-left">User</th>
                            <th class="px-4 py-3 text-left">Date</th>
                            <th class="px-4 py-3 text-left">Amount</th>
                            <th class="px-4 py-3 text-left">Type</th>
                            <th class="px-4 py-3 text-left">Details</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <% if (wallets && wallets.length > 0) { %>
                            <% wallets.forEach(wallet => { %>
                                <% const isCredit = wallet?.transactions?.transactionType === 'credit'; %>
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-4 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                        #<%= wallet?.transactions?.transactionId %>
                                    </td>
                                    <td class="px-4 py-4 whitespace-nowrap">
                                        <div class="text-sm text-gray-900"><%= wallet?.user?.username || 'Unknown user' %></div>
                                        <div class="text-xs text-gray-500"><%= wallet?.user?.email || '' %></div>
                                    </td>
                                    <td class="px-4 py-4 whitespace-nowrap text-xs text-gray-500">
                                        <%= wallet?.transactions?.createdAt ? new Date(wallet.transactions.createdAt).toLocaleString('en-US', {
                                            year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true
                                        }) : '—' %>
                                    </td>
                                    <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-900">
                                        Rs. <%= Number(wallet?.transactions?.amount || 0).toFixed(2) %>
                                    </td>
                                    <td class="px-4 py-4 whitespace-nowrap">
                                        <span class="text-xs font-semibold px-2.5 py-1 rounded-full <%= isCredit ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                            <%= isCredit ? 'Credited' : 'Debited' %>
                                        </span>
                                        <% if (wallet?.transactions?.source) { %>
                                            <span class="text-xs text-gray-500 ml-1 capitalize"><%= wallet.transactions.source %></span>
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-4 whitespace-nowrap">
                                        <% if (wallet?.transactions?.source === 'refund' && wallet?.transactions?.orderId) { %>
                                            <a href="/admin/view-order/<%= wallet.transactions.orderId %>/<%= wallet.transactions?.productId %>"
                                                class="text-sm bg-slate-900 text-white px-3 py-1.5 rounded-lg hover:bg-slate-800 transition duration-200">
                                                View Order
                                            </a>
                                        <% } else { %>
                                            <span class="text-xs text-gray-400">&mdash;</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="px-6 py-8 text-sm text-gray-500 text-center">No transactions found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="flex justify-center mt-6">
                <%
                  const pageQuery = (typeof query !== 'undefined' && query) ? '&query=' + encodeURIComponent(query) : '';
                %>
                <nav class="flex justify-center mt-6">
                    <ul class="inline-flex items-center -space-x-px text-sm">
                      <!-- Previous Page -->
                      <% if(page > 1){ %>
                        <li>
                          <a href="/admin/transactions?page=<%= page - 1 %>&limit=<%= limit %><%= pageQuery %>"
                             class="flex items-center justify-center px-3 h-10 ml-0 leading-tight text-gray-500 bg-white border border-gray-300 rounded-l-lg hover:bg-gray-100">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                          </a>
                        </li>
                      <% } else { %>
                        <li>
                          <span class="flex items-center justify-center px-3 h-10 ml-0 leading-tight text-gray-300 bg-gray-100 border border-gray-200 rounded-l-lg cursor-not-allowed">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                          </span>
                        </li>
                      <% } %>

                      <!-- Page Numbers -->
                      <% for(let i = 1; i <= totalPages; i++) { %>
                        <li>
                          <a href="/admin/transactions?page=<%= i %>&limit=<%= limit %><%= pageQuery %>"
                             class="flex items-center justify-center px-3 h-10 leading-tight
                                    border border-gray-300
                                    <%= page === i ? 'bg-blue-500 text-white' : 'bg-white text-gray-500 hover:bg-gray-100' %>">
                            <%= i %>
                          </a>
                        </li>
                      <% } %>

                      <!-- Next Page -->
                      <% if(page < totalPages){ %>
                        <li>
                          <a href="/admin/transactions?page=<%= page + 1 %>&limit=<%= limit %><%= pageQuery %>"
                             class="flex items-center justify-center px-3 h-10 leading-tight text-gray-500 bg-white border border-gray-300 rounded-r-lg hover:bg-gray-100">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                          </a>
                        </li>
                      <% } else { %>
                        <li>
                          <span class="flex items-center justify-center px-3 h-10 leading-tight text-gray-300 bg-gray-100 border border-gray-200 rounded-r-lg cursor-not-allowed">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                          </span>
                        </li>
                      <% } %>
                    </ul>
                  </nav>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('searchForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const value = this.querySelector('input[name="searchInput"]').value.trim();
            window.location.href = `/admin/transactions?page=1&limit=<%= limit %>${value ? '&query=' + encodeURIComponent(value) : ''}`;
        });
    </script>
</body>
</html>
