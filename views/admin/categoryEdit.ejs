<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Category - Read & Grow Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.5.0/dist/sweetalert2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.5.0/dist/sweetalert2.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <style>
        * {
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        body {
            overscroll-behavior: none;
            margin: 0;
        }
        .container-fluid {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }
    </style>
</head>

<body class="bg-gray-50 text-gray-800 font-sans">
    <div class="container-fluid">

        <!-- Sidebar -->
        <%- include("../partials/admin/adminSideBar.ejs") %>

        <!-- Main Content -->
        <div class="flex-1 p-4 pt-20 sm:p-6 md:pt-6 min-w-0">
            <%- include("../partials/admin/breadcrumb.ejs", { breadcrumbs: [{ label: 'Category', url: '/admin/category' }, { label: 'Edit Category' }] }) %>
            <header class="bg-white shadow-sm sticky top-0 z-10 mb-6 rounded-xl">
                <div class="flex justify-between items-center px-6 py-4">
                    <h1 class="text-2xl font-semibold text-gray-800">Edit Category</h1>
                </div>
            </header>

            <div class="bg-white rounded-lg shadow-md p-6 max-w-2xl mx-auto">
                <div class="mb-6">
                    <h2 class="text-xl font-semibold text-gray-800">Modify Category Details</h2>
                    <p class="text-gray-600 mt-1">Update the category information below</p>
                </div>

                <!-- Form -->
                <form id="editCategory" class="space-y-6">
                    <input type="hidden" id="categoryId" name="categoryId" value="<%= findCategory._id %>">
                    <!-- Category Name -->
                    <div>
                        <label for="categoryName" class="block text-sm font-medium text-gray-700 mb-1">Category Name*</label>
                        <input type="text" id="categoryName" name="categoryName" required value="<%= findCategory.categoryName %>"
                            pattern="[A-Za-z][A-Za-z0-9&amp;',.\-\s]{1,49}"
                            title="Must start with a letter; letters, numbers, spaces, and &amp; ' , . - only"
                            class="mt-1 block w-full border border-gray-300 rounded-lg py-2 px-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <p id="categoryNameError" class="mt-1 text-sm text-red-600 hidden"></p>
                    </div>

                    <!-- Category Description -->
                    <div>
                        <label for="categoryDescription" class="block text-sm font-medium text-gray-700 mb-1">Description*</label>
                        <textarea id="categoryDescription" name="categoryDescription" required rows="4" maxlength="500"
                            class="mt-1 block w-full border border-gray-300 rounded-lg py-2 px-3 focus:outline-none focus:ring-2 focus:ring-blue-500"><%= findCategory.description %></textarea>
                        <p id="categoryDescriptionError" class="mt-1 text-sm text-red-600 hidden"></p>
                    </div>

                    <!-- Category Status -->
                    <div>
                        <label for="categoryStatus" class="block text-sm font-medium text-gray-700 mb-1">Status*</label>
                        <select id="categoryStatus" name="categoryStatus" required
                            class="mt-1 block w-full border border-gray-300 rounded-lg py-2 px-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="active" <%= findCategory?.status === 'active' ? 'selected' : '' %>>Active</option>
                            <option value="inactive" <%= findCategory?.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="flex flex-col sm:flex-row gap-4 pt-4">
                        <button type="submit"
                            class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition w-full sm:w-auto">
                            Save Changes
                        </button>
                        <a href="/admin/category"
                            class="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition text-center w-full sm:w-auto">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Mirrors the server-side CATEGORY_NAME_REGEX/CATEGORY_DESCRIPTION_REGEX in
        // adminController.js — catches obviously-invalid input immediately instead of making
        // the admin wait on a round trip to find out.
        const CATEGORY_NAME_REGEX = /^[A-Za-z][A-Za-z0-9&',.\-\s]{1,49}$/;
        const CATEGORY_DESCRIPTION_REGEX = /^[^<>]{1,500}$/;

        function showFieldError(fieldId, message) {
            const el = document.getElementById(fieldId + 'Error');
            if (!el) return;
            if (message) {
                el.textContent = message;
                el.classList.remove('hidden');
            } else {
                el.classList.add('hidden');
            }
        }

        function validateCategoryForm(categoryName, categoryDescription) {
            if (!CATEGORY_NAME_REGEX.test(categoryName)) {
                showFieldError('categoryName', "Must start with a letter and contain only letters, numbers, spaces, and & ' , . -");
                return false;
            }
            showFieldError('categoryName', '');
            if (!CATEGORY_DESCRIPTION_REGEX.test(categoryDescription)) {
                showFieldError('categoryDescription', "Under 500 characters, and cannot contain < or >");
                return false;
            }
            showFieldError('categoryDescription', '');
            return true;
        }

        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById('editCategory').addEventListener('submit', async function (event) {
                event.preventDefault();

                const categoryId = document.getElementById('categoryId').value.trim();
                const categoryName = document.getElementById('categoryName').value.trim();
                const categoryDescription = document.getElementById('categoryDescription').value.trim();
                const categoryStatus = document.getElementById('categoryStatus').value.trim();

                if (!validateCategoryForm(categoryName, categoryDescription)) {
                    return;
                }

                try {
                    Swal.fire({
                        title: 'Saving...',
                        text: 'Please wait',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    const response = await fetch(`/admin/category/${categoryId}`, {
                        method: "PATCH",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            categoryName,
                            categoryDescription,
                            status: categoryStatus
                        })
                    });

                    const result = await response.json();
                    Swal.close();

                    if (!response.ok) {
                        throw new Error(result.message || 'Something went wrong');
                    }

                    if (result.success) {
                        Toastify({
                            text: result.message || "Category updated successfully",
                            duration: 3000,
                            gravity: "top",
                            position: "right",
                            backgroundColor: "#4CAF50",
                            close: true
                        }).showToast();
                        setTimeout(() => window.location.href = result.redirect || '/admin/category', 1500);
                    }
                } catch (error) {
                    console.error(`Edit category fetch failed: ${error.message}`);
                    Toastify({
                        text: error.message || "Error while updating category",
                        duration: 3000,
                        gravity: "top",
                        position: "right",
                        backgroundColor: "#f44336",
                        close: true
                    }).showToast();
                }
            });
        });
    </script>
</body>
</html>