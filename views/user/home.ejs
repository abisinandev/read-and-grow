<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Read & Grow - Your ultimate destination for personal growth and development books">
    <title>Read & Grow - Book Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdn.jsdelivr.net/npm/toastify-js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/user/showMessage.js" defer></script>
    <script src="/js/user/home.js" defer></script>

    <style>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeIn 0.8s ease-out forwards;
        }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col bg-white">

    <!-- Navbar -->
    <% if (user) { %>
        <%- include("../partials/user/navBar.ejs") %>
    <% } else { %>
        <%- include("../partials/user/guestNavBar.ejs") %>
    <% } %>

    <!-- Hero -->
    <section class="relative">
        <div class="relative h-[420px] sm:h-[480px] lg:h-[540px] overflow-hidden">
            <img src="/images/wallpaperflare.com_wallpaper (2).jpg" alt=""
                class="absolute inset-0 w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-r from-gray-950/90 via-gray-950/70 to-gray-950/30"></div>

            <div class="relative h-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center">
                <div class="max-w-xl animate-fade-in">
                    <p class="text-yellow-400 font-semibold tracking-[0.2em] uppercase text-xs sm:text-sm mb-4">
                        Read &amp; Grow
                    </p>
                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight mb-5 bg-clip-text text-transparent bg-gradient-to-r from-yellow-200 to-orange-400 uppercase">
                        Never Stop Learning
                    </h1>
                    <p class="text-gray-200 text-base sm:text-lg italic mb-8">— Marcus Aurelius</p>

                    <div class="flex flex-wrap gap-3">
                        <% if (user) { %>
                            <a href="/shop"
                                class="inline-flex items-center gap-2 bg-white text-gray-900 font-semibold px-6 py-3 rounded-lg hover:bg-gray-100 transition">
                                <i class="fas fa-book-open"></i> Shop Now
                            </a>
                        <% } else { %>
                            <button onclick="pleaseLogin()"
                                class="inline-flex items-center gap-2 bg-white text-gray-900 font-semibold px-6 py-3 rounded-lg hover:bg-gray-100 transition">
                                <i class="fas fa-book-open"></i> Shop Now
                            </button>
                        <% } %>
                        <a href="#popular-books"
                            class="inline-flex items-center gap-2 border border-white/40 text-white font-semibold px-6 py-3 rounded-lg hover:bg-white/10 transition">
                            Explore Popular Books
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Trust strip -->
    <section class="bg-white border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-2 sm:grid-cols-4 gap-6">
            <div class="flex items-center gap-3">
                <span class="w-11 h-11 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                    <i class="fas fa-shield-halved"></i>
                </span>
                <div>
                    <p class="font-semibold text-gray-900 text-sm">Secure Payments</p>
                    <p class="text-gray-500 text-xs">Protected checkout</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="w-11 h-11 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                    <i class="fas fa-rotate-left"></i>
                </span>
                <div>
                    <p class="font-semibold text-gray-900 text-sm">Easy Returns</p>
                    <p class="text-gray-500 text-xs">Simple return requests</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="w-11 h-11 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
                    <i class="fas fa-truck-fast"></i>
                </span>
                <div>
                    <p class="font-semibold text-gray-900 text-sm">Doorstep Delivery</p>
                    <p class="text-gray-500 text-xs">Tracked shipping</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="w-11 h-11 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
                    <i class="fas fa-headset"></i>
                </span>
                <div>
                    <p class="font-semibold text-gray-900 text-sm">Dedicated Support</p>
                    <p class="text-gray-500 text-xs">We're here to help</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Browse by Category -->
    <% if (typeof categories !== 'undefined' && categories.length) { %>
        <section class="py-14 px-4 sm:px-6 lg:px-8 bg-gray-50">
            <div class="max-w-7xl mx-auto">
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8 text-center">Browse by Category</h2>
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
                    <% categories.forEach(cat => { %>
                        <% if (user) { %>
                            <a href="/shop?category=<%= encodeURIComponent(cat.categoryName) %>&page=1&limit=6"
                                class="group bg-white rounded-xl p-5 text-center shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 border border-gray-100">
                                <span class="w-12 h-12 mx-auto rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center mb-3 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                                    <i class="fas fa-book"></i>
                                </span>
                                <p class="font-medium text-gray-800 text-sm truncate"><%= cat.categoryName %></p>
                            </a>
                        <% } else { %>
                            <button onclick="pleaseLogin()"
                                class="group bg-white rounded-xl p-5 text-center shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 border border-gray-100">
                                <span class="w-12 h-12 mx-auto rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center mb-3 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                                    <i class="fas fa-book"></i>
                                </span>
                                <p class="font-medium text-gray-800 text-sm truncate"><%= cat.categoryName %></p>
                            </button>
                        <% } %>
                    <% }) %>
                </div>
            </div>
        </section>
    <% } %>

    <!-- Popular Books -->
    <section id="popular-books" class="py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-gray-50 to-white">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-10">
                <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight">
                    Popular Books
                </h2>
                <p class="text-gray-500 mt-2">Best-selling picks our readers keep coming back for</p>
            </div>

            <% if (!products || products.length === 0) { %>
                <div class="text-center py-16 text-gray-500">
                    <i class="fas fa-book-open text-4xl mb-4 opacity-40"></i>
                    <p>No popular books to show yet — check back soon.</p>
                </div>
            <% } else { %>
                <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% products.forEach(product => { %>
                        <% const inWishlist = user && typeof wishlistProductIds !== 'undefined'
                            && wishlistProductIds.includes(String(product._id)); %>
                        <article class="bg-white rounded-xl shadow-md overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1 border border-gray-100">
                            <div class="bg-gray-50 relative">
                                <a href="/product-details/<%= product._id %>" class="flex justify-center">
                                    <img src="<%= product.images[0] %>" alt="<%= product.name %>"
                                        class="w-auto h-52 md:h-64 object-cover rounded-t-md">
                                </a>

                                <% if (!user) { %>
                                    <button onclick="pleaseLogin()"
                                        class="absolute top-3 right-3 p-2 bg-white rounded-full shadow-sm hover:bg-gray-100"
                                        aria-label="Add to wishlist">
                                        <i class="far fa-heart text-gray-600"></i>
                                    </button>
                                <% } else if (inWishlist) { %>
                                    <button onclick="removeWishlist('<%= product._id %>')"
                                        class="wishlist-btn absolute top-3 right-3 p-2 bg-white rounded-full shadow-sm hover:bg-gray-100"
                                        data-product-id="<%= product._id %>" aria-label="Remove from wishlist">
                                        <i class="fas fa-heart text-red-500"></i>
                                    </button>
                                <% } else { %>
                                    <button onclick="addToWishlist(this, '<%= product._id %>')"
                                        class="wishlist-btn absolute top-3 right-3 p-2 bg-white rounded-full shadow-sm hover:bg-gray-100"
                                        data-product-id="<%= product._id %>" aria-label="Add to wishlist">
                                        <i class="far fa-heart text-gray-600"></i>
                                    </button>
                                <% } %>
                            </div>

                            <div class="p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-1 line-clamp-2 hover:text-indigo-600 transition-colors duration-200">
                                    <a href="/product-details/<%= product._id %>"><%= product.name %></a>
                                </h3>
                                <p class="text-gray-500 mb-3 text-sm italic"><%= product.authorName %></p>
                                <div class="text-yellow-400 space-x-1 mb-3">
                                    <% for (let i = 0; i < 5; i++) { %>
                                        <i class="<%= i < Math.floor(product.rating || 0) ? 'fas' : 'far' %> fa-star text-sm md:text-base"></i>
                                    <% } %>
                                </div>
                                <% if (product.bestOffer) { %>
                                    <span class="inline-block text-xs font-bold text-red-600 bg-red-50 px-2 py-1 rounded mb-3">
                                        <%= product.bestOffer %>% OFF
                                    </span>
                                <% } %>
                                <div class="flex items-center justify-between mt-2">
                                    <span class="text-xl md:text-2xl font-bold text-gray-900 bg-gradient-to-r from-green-600 to-teal-600 bg-clip-text text-transparent">
                                        Rs. <%= product.price %>
                                    </span>
                                    <% if (user) { %>
                                        <button onclick="addToCart('<%= product._id %>')"
                                            <%= product.stock > 0 ? "" : "disabled" %>
                                            class="<%= product.stock > 0
                                                ? 'bg-black text-white px-4 py-2 rounded-lg hover:bg-gray-800 transition-all duration-200 transform hover:scale-105'
                                                : 'bg-gray-300 text-white px-4 py-2 rounded-lg cursor-not-allowed' %>"
                                            aria-label="Add <%= product.name %> to cart">
                                            <%= product.stock > 0 ? "Add to Cart" : "Out of Stock" %>
                                        </button>
                                    <% } else { %>
                                        <button onclick="pleaseLogin()"
                                            class="bg-black text-white px-4 py-2 rounded-lg hover:bg-gray-800 transition-all duration-200 transform hover:scale-105"
                                            aria-label="Add <%= product.name %> to cart">
                                            Add to Cart
                                        </button>
                                    <% } %>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>

            <div class="text-center mt-12">
                <% if (!user) { %>
                    <button onclick="pleaseLogin()"
                        class="inline-flex items-center text-lg font-semibold text-indigo-600 hover:text-indigo-800 transition-colors duration-200 group">
                        Shop All Books
                        <i class="fas fa-arrow-right ml-2 transform group-hover:translate-x-1 transition-transform duration-200"></i>
                    </button>
                <% } else { %>
                    <a href="/shop?page=1&limit=6"
                        class="inline-flex items-center text-lg font-semibold text-gray-700 hover:text-indigo-800 transition-colors duration-200 group">
                        Shop All Books
                        <i class="fas fa-arrow-right ml-2 transform group-hover:translate-x-1 transition-transform duration-200"></i>
                    </a>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <%- include("../partials/user/footer.ejs") %>

</body>

</html>
