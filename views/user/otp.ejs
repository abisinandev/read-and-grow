<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTP Verification - REad & GroW</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/toastify-js@1.12.0/src/toastify.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/toastify-js@1.12.0/src/toastify.min.js"></script>
    <style>
        .otp-input {
            width: 3.5rem;
            height: 3.5rem;
            text-align: center;
            font-size: 1.5rem;
            font-weight: 600;
            border: 2px solid #d1d5db;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }
        .otp-input:focus {
            border-color: #dc2626;
            box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.15);
            outline: none;
        }
        .otp-input:hover:not(:focus) {
            border-color: #fca5a5;
        }
        .animate-fade-in {
            animation: fadeIn 0.6s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-gray-50 flex items-center justify-center min-h-screen p-4">
    <div class="w-full max-w-sm animate-fade-in">
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <div class="bg-red-600 px-8 py-7 text-center">
                <span class="inline-flex w-11 h-11 rounded-xl bg-white/15 items-center justify-center mb-2">
                    <i class="fas fa-shield-halved text-white text-base"></i>
                </span>
                <h1 class="text-white text-lg font-semibold tracking-tight">REad &amp; GroW</h1>
                <p class="text-red-100 text-xs mt-1">Verify it's really you</p>
            </div>

            <div class="p-8">
                <h2 class="text-lg font-semibold text-gray-800 mb-1 text-center">Enter verification code</h2>
                <p class="text-sm text-gray-500 mb-6 text-center">
                    <% if (maskedEmail) { %>
                        We sent a 4-digit code to <span class="font-medium text-gray-700"><%= maskedEmail %></span>
                    <% } else { %>
                        We sent a 4-digit code to your email
                    <% } %>
                </p>

                <form id="otpForm" class="space-y-6">
                    <div class="flex justify-center space-x-3">
                        <input type="text" inputmode="numeric" pattern="[0-9]*" id="otp1" maxlength="1" class="otp-input" required aria-label="OTP digit 1">
                        <input type="text" inputmode="numeric" pattern="[0-9]*" id="otp2" maxlength="1" class="otp-input" required aria-label="OTP digit 2">
                        <input type="text" inputmode="numeric" pattern="[0-9]*" id="otp3" maxlength="1" class="otp-input" required aria-label="OTP digit 3">
                        <input type="text" inputmode="numeric" pattern="[0-9]*" id="otp4" maxlength="1" class="otp-input" required aria-label="OTP digit 4">
                    </div>

                    <div class="flex justify-between items-center text-xs sm:text-sm text-gray-600">
                        <button type="button" id="resendOtp" class="text-red-600 hover:text-red-700 font-medium transition-colors disabled:text-gray-400 disabled:cursor-not-allowed" disabled>Resend code</button>
                        <span id="Timer" class="font-medium text-gray-700"></span>
                    </div>

                    <button type="submit" id="verifyBtn"
                            class="w-full bg-red-600 text-white py-2.5 rounded-full text-base font-semibold hover:bg-red-700 transition-colors duration-200 shadow-md disabled:opacity-50 disabled:cursor-not-allowed">
                        Verify code
                    </button>
                </form>

                <p class="text-center text-xs text-gray-500 mt-6">
                    Wrong email or started this by mistake?
                    <a href="/signup" class="text-red-600 font-medium hover:underline">Start over</a>
                </p>
            </div>
        </div>
    </div>

    <script>
        function showToast(message, type = 'error') {
            Toastify({
                text: message,
                duration: 2500,
                gravity: "top",
                position: "center",
                backgroundColor: type === 'success' ? "#16a34a" : "#dc2626",
                stopOnFocus: true,
            }).showToast();
        }

        const otpInputs = document.querySelectorAll('.otp-input');
        otpInputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                e.target.value = e.target.value.replace(/[^0-9]/g, '');
                if (e.target.value.length === 1 && index < otpInputs.length - 1) {
                    otpInputs[index + 1].focus();
                }
            });
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !e.target.value && index > 0) {
                    otpInputs[index - 1].focus();
                }
            });
        });

        document.getElementById('otpForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            const verifyBtn = document.getElementById('verifyBtn');
            if (verifyBtn.disabled) {
                showToast('This code has expired. Please resend a new one.');
                return;
            }
            const otp = Array.from(otpInputs).map(input => input.value).join('');
            if (otp.length !== 4) {
                showToast('Please enter the 4-digit code');
                return;
            }
            verifyBtn.disabled = true;
            try {
                // Auth here is the session cookie (sent automatically with a same-origin
                // fetch) — the same session that /otp-verify's GET already checked before
                // this page was ever rendered, not a client-held token.
                const response = await fetch('/otp/otp-verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ otp }),
                });
                const result = await response.json();
                if (!response.ok) {
                    showToast(result.message || 'Invalid code');
                    if (result.redirect) {
                        setTimeout(() => { window.location.href = result.redirect; }, 1500);
                    } else {
                        verifyBtn.disabled = false;
                    }
                    return;
                }
                if (result.success) {
                    showToast(result.message || 'Verified successfully', 'success');
                    setTimeout(() => {
                        window.location.href = result.redirect || '/';
                    }, 1000);
                }
            } catch (error) {
                showToast('An error occurred. Please try again.');
                console.error(`OTP verification error: ${error.message}`);
                verifyBtn.disabled = false;
            }
        });

        document.getElementById('resendOtp').addEventListener('click', async function () {
            this.disabled = true;
            try {
                const response = await fetch('/otp/send-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                });
                const result = await response.json();
                if (!response.ok) {
                    showToast(result.message || 'Failed to resend code');
                    if (result.redirect) {
                        setTimeout(() => { window.location.href = result.redirect; }, 1500);
                    } else {
                        this.disabled = false;
                    }
                    return;
                }
                showToast(result.message || 'Code resent successfully', 'success');
                otpTimer(<%= otpExpirySeconds %>);
            } catch (error) {
                showToast('An error occurred while resending the code.');
                console.error(`Resend OTP error: ${error.message}`);
                this.disabled = false;
            }
        });

        function otpTimer(duration) {
            let time = duration;
            const timer = document.getElementById('Timer');
            const resendOtp = document.getElementById('resendOtp');
            const verifyBtn = document.getElementById('verifyBtn');

            clearInterval(window.__otpInterval);

            function render() {
                const minutes = Math.floor(time / 60);
                const seconds = time % 60;
                if (time > 0) {
                    timer.textContent = `Expires in ${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
                    resendOtp.disabled = true;
                    verifyBtn.disabled = false;
                } else {
                    timer.textContent = 'Code expired';
                    resendOtp.disabled = false;
                    verifyBtn.disabled = true;
                }
            }

            render();
            window.__otpInterval = setInterval(() => {
                time--;
                if (time < 0) {
                    clearInterval(window.__otpInterval);
                    return;
                }
                render();
            }, 1000);
        }

        // Seeded from the server's real OTP creation time, not a hardcoded fresh window —
        // refreshing this page no longer grants extra time the server won't honor.
        otpTimer(<%= remainingSeconds %>);
    </script>
</body>
</html>
