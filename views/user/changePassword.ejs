<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.5.0/dist/sweetalert2.min.css" rel="stylesheet">
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.5.0/dist/sweetalert2.all.min.js"></script>
    <!-- Toastify CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <style>
        /* FIELD ERROR STATE */
        .field-error input {
            border-color: #ef4444 !important;
            background-color: #fef2f2 !important;
        }
        .field-error-msg {
            display: none;
            color: #dc2626;
            font-size: 12px;
            margin-top: 4px;
        }
        .field-error .field-error-msg {
            display: block;
        }
    </style>
</head>

<body class="bg-gray-100 flex items-center justify-center min-h-screen">

    <div class="bg-white rounded-2xl shadow-xl w-full max-w-4xl p-6">
        <h2 class="text-lg font-semibold text-gray-800">Your Account</h2>

        <% if(user && user?.password){%>
            <div class="flex mt-6 gap-6">
                <!-- Sidebar -->
                <%- include("../partials/user/sideBar.ejs") %>

                <!-- Form Section -->
                <div class="w-2/3">
                    <div class="bg-gray-50 border border-gray-200 rounded-xl p-6">
                        <h3 class="text-base font-semibold text-gray-700 mb-5">Change Password</h3>

                        <!-- GLOBAL ERROR BANNER (shown when backend returns non-field error) -->
                        <div id="globalError" class="hidden mb-4 p-3 bg-red-50 border border-red-300 rounded-lg text-sm text-red-700 flex items-center gap-2">
                            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M12 3a9 9 0 110 18A9 9 0 0112 3z"/>
                            </svg>
                            <span id="globalErrorText"></span>
                        </div>

                        <form id="formData" novalidate>
                            <input type="text" value="<%= user.id %>" hidden id="userId">

                            <!-- OLD PASSWORD -->
                            <div class="mb-4" id="wrap-oldPassword">
                                <label class="block text-sm font-medium text-gray-700 mb-1">Old Password</label>
                                <div class="relative">
                                    <input type="password" name="oldPassword" id="oldPassword"
                                        class="block w-full px-3 py-2 pr-10 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-gray-400 transition"
                                        required>
                                    <button type="button" onclick="togglePassword('oldPassword', 'eyeOld')"
                                        class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-400 hover:text-gray-700 transition">
                                        <svg id="eyeOld" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                    </button>
                                </div>
                                <!-- INLINE FIELD ERROR -->
                                <p class="field-error-msg" id="err-oldPassword"></p>
                            </div>

                            <!-- NEW PASSWORD -->
                            <div class="mb-4" id="wrap-newPassword">
                                <label class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
                                <div class="relative">
                                    <input type="password" name="newPassword" id="newPassword"
                                        class="block w-full px-3 py-2 pr-10 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-gray-400 transition"
                                        required>
                                    <button type="button" onclick="togglePassword('newPassword', 'eyeNew')"
                                        class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-400 hover:text-gray-700 transition">
                                        <svg id="eyeNew" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                    </button>
                                </div>
                                <p class="field-error-msg" id="err-newPassword"></p>
                            </div>

                            <!-- CONFIRM PASSWORD -->
                            <div class="mb-6" id="wrap-confirmPassword">
                                <label class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
                                <div class="relative">
                                    <input type="password" name="confirmPassword" id="confirmPassword"
                                        class="block w-full px-3 py-2 pr-10 border border-gray-300 rounded-lg bg-white text-sm focus:outline-none focus:ring-2 focus:ring-gray-400 transition"
                                        required>
                                    <button type="button" onclick="togglePassword('confirmPassword', 'eyeConfirm')"
                                        class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-400 hover:text-gray-700 transition">
                                        <svg id="eyeConfirm" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                    </button>
                                </div>
                                <p class="field-error-msg" id="err-confirmPassword"></p>
                            </div>

                            <button type="submit" id="submitBtn"
                                class="w-full bg-gray-800 text-white py-2 rounded-lg text-sm font-medium hover:bg-red-600 transition duration-200 flex items-center justify-center gap-2">
                                <span id="btnText">Change Password</span>
                                <!-- LOADING SPINNER (hidden by default) -->
                                <svg id="btnSpinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        <% }else{%>
            <div class="mt-6 p-5 bg-yellow-50 border border-yellow-300 rounded-xl flex flex-col gap-3 max-w-md">
                <p class="text-yellow-800 font-medium text-sm">
                    ⚠️ Google-authenticated users cannot change their password here.
                </p>
                <a href="/profile/<%= user?.id %>" class="text-sm text-blue-600 hover:underline">← Back to Profile</a>
            </div>
        <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script>

        //EYE TOGGLE FUNCTION
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            const isHidden = input.type === 'password';

            input.type = isHidden ? 'text' : 'password';

            //EYE-OPEN SVG PATH
            const eyeOpen = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`;

            //EYE-CLOSED SVG PATH
            const eyeClosed = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />`;

            icon.innerHTML = isHidden ? eyeClosed : eyeOpen;
        }

        //SHOW TOAST NOTIFICATION
        function showToast(message, type = 'error') {
            Toastify({
                text: message,
                duration: 3000,
                gravity: "top",
                position: "right",
                backgroundColor: type === 'success' ? "#16a34a" : "#dc2626",
                stopOnFocus: true,
            }).showToast();
        }

        //CLEAR ALL FIELD ERRORS
        function clearFieldErrors() {
            ['oldPassword', 'newPassword', 'confirmPassword'].forEach(field => {
                const wrap = document.getElementById(`wrap-${field}`);
                const errEl = document.getElementById(`err-${field}`);
                if (wrap) wrap.classList.remove('field-error');
                if (errEl) errEl.textContent = '';
            });
            document.getElementById('globalError').classList.add('hidden');
        }

        //SHOW INLINE FIELD ERROR FROM BACKEND RESPONSE
        function showFieldError(field, message) {
            const wrap = document.getElementById(`wrap-${field}`);
            const errEl = document.getElementById(`err-${field}`);
            if (wrap && errEl) {
                wrap.classList.add('field-error');
                errEl.textContent = message;
            } else {
                //NO SPECIFIC FIELD — SHOW IN GLOBAL BANNER
                const globalError = document.getElementById('globalError');
                document.getElementById('globalErrorText').textContent = message;
                globalError.classList.remove('hidden');
            }
        }

        //FORM SUBMIT HANDLER
        document.getElementById('formData').addEventListener('submit', async (e) => {
            e.preventDefault();
            clearFieldErrors();

            const oldPassword = document.getElementById('oldPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            //CLIENT-SIDE VALIDATION
            if (!oldPassword || !newPassword || !confirmPassword) {
                showToast('Please fill in all password fields');
                return;
            }

            if (newPassword !== confirmPassword) {
                showFieldError('confirmPassword', 'New passwords do not match');
                return;
            }

            if (newPassword.length < 6) {
                showFieldError('newPassword', 'Password must be at least 6 characters');
                return;
            }

            //LOADING STATE
            const btn = document.getElementById('submitBtn');
            const btnText = document.getElementById('btnText');
            const spinner = document.getElementById('btnSpinner');
            btn.disabled = true;
            btnText.textContent = 'Updating...';
            spinner.classList.remove('hidden');

            const userId = document.getElementById('userId').value;

            try {
                const response = await fetch('/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ oldPassword, newPassword, confirmPassword })
                });

                const data = await response.json();

                if (!response.ok) {
                    //IF BACKEND SENDS A FIELD — SHOW INLINE ERROR
                    if (data.field) {
                        showFieldError(data.field, data.message);
                    } else {
                        showFieldError(null, data.message || 'Failed to change password');
                    }
                    return;
                }

                showToast('Password changed successfully', 'success');
                setTimeout(() => {
                    window.location.href = `/profile/${data.data.id}`
                }, 1500);

            } catch (error) {
                console.error('Error changing password:', error);
                showFieldError(null, 'An unexpected error occurred. Please try again.');
            } finally {
                //RESET LOADING STATE
                btn.disabled = false;
                btnText.textContent = 'Change Password';
                spinner.classList.add('hidden');
            }
        });
    </script>
</body>

</html>
