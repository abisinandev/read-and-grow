<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - REad & GroW</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="/js/user/signup.js" defer></script>
    <style>
        .error { color: #dc2626; font-size: 12px; margin-top: 2px; }
    </style>
</head>

<body class="bg-gray-50 flex items-center justify-center min-h-screen p-4">
    <div class="w-full max-w-sm">
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <div class="bg-red-600 px-8 py-7 text-center">
                <span class="inline-flex w-11 h-11 rounded-xl bg-white/15 items-center justify-center mb-2">
                    <i class="fas fa-book-open text-white text-base"></i>
                </span>
                <h1 class="text-white text-lg font-semibold tracking-tight">REad &amp; GroW</h1>
                <p class="text-red-100 text-xs mt-1">Your next favorite book is waiting.</p>
            </div>

            <form class="p-8 space-y-4" id="form" method="post" novalidate>
                <h2 class="text-lg font-semibold text-gray-800 mb-1">Create an account</h2>
                <p class="text-sm text-gray-500 mb-4">Join REad &amp; GroW to start shopping.</p>

                <div>
                    <label for="username" class="block text-xs font-medium text-gray-600 mb-1">Username</label>
                    <div class="relative">
                        <i class="fas fa-user absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-400 text-sm"></i>
                        <input type="text" placeholder="Username" id="username" required autocomplete="username"
                            class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
                    </div>
                </div>

                <div>
                    <label for="email" class="block text-xs font-medium text-gray-600 mb-1">Email</label>
                    <div class="relative">
                        <i class="fas fa-envelope absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-400 text-sm"></i>
                        <input type="email" placeholder="Email" id="email" required autocomplete="email"
                            class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
                    </div>
                </div>

                <div>
                    <label for="phoneNumber" class="block text-xs font-medium text-gray-600 mb-1">Phone number</label>
                    <div class="relative">
                        <i class="fas fa-phone absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-400 text-sm"></i>
                        <input type="tel" placeholder="Phone number" id="phoneNumber" required autocomplete="tel"
                            inputmode="numeric" maxlength="10"
                            class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
                    </div>
                </div>

                <div>
                    <label for="password" class="block text-xs font-medium text-gray-600 mb-1">Password</label>
                    <div class="relative">
                        <i class="fas fa-key absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-400 text-sm"></i>
                        <input type="password" placeholder="Password" id="password" required autocomplete="new-password"
                            class="w-full pl-10 pr-10 py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
                        <button type="button" class="password-toggle-icon absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600"
                            tabindex="-1" aria-label="Show password">
                            <i class="fas fa-eye" data-target="password"></i>
                        </button>
                    </div>
                </div>

                <div>
                    <label for="confirmPassword" class="block text-xs font-medium text-gray-600 mb-1">Confirm password</label>
                    <div class="relative">
                        <i class="fas fa-key absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-400 text-sm"></i>
                        <input type="password" placeholder="Confirm password" id="confirmPassword" required autocomplete="new-password"
                            class="w-full pl-10 pr-10 py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
                        <button type="button" class="password-toggle-icon absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600"
                            tabindex="-1" aria-label="Show password">
                            <i class="fas fa-eye" data-target="confirmPassword"></i>
                        </button>
                    </div>
                </div>

                <div>
                    <label for="referalCode" class="block text-xs font-medium text-gray-600 mb-1">Referral code <span class="text-gray-400 font-normal">(optional)</span></label>
                    <div class="relative">
                        <i class="fas fa-gift absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-400 text-sm"></i>
                        <input type="text" placeholder="Referral code" id="referalCode"
                            class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
                    </div>
                </div>

                <p class="text-xs text-gray-500 pt-1">
                    Already have an account? <a href="/login" class="text-red-600 font-medium hover:underline">Log in</a>
                </p>

                <button type="submit" id="signupButton"
                    class="w-full bg-red-600 text-white py-2.5 rounded-lg font-medium text-sm hover:bg-red-700 transition duration-200 mt-1 flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed">
                    <i id="signupButtonSpinner" class="fas fa-circle-notch fa-spin hidden"></i>
                    <span id="signupButtonText">Sign Up</span>
                </button>

                <div class="flex items-center gap-3 py-1">
                    <div class="h-px bg-gray-200 flex-1"></div>
                    <span class="text-[11px] text-gray-400 uppercase tracking-wide">or</span>
                    <div class="h-px bg-gray-200 flex-1"></div>
                </div>

                <a href="/auth/google"
                    class="w-full border border-gray-300 text-gray-700 py-2.5 rounded-lg hover:bg-gray-50 transition duration-200 flex items-center justify-center gap-2 text-sm font-medium">
                    <img src="https://img.icons8.com/?size=100&id=17949&format=png&color=000000" alt="Google" class="h-5 w-5">
                    Continue with Google
                </a>
            </form>
        </div>

        <div class="text-center mt-5">
            <a href="/" class="text-xs text-gray-500 hover:text-gray-700 inline-flex items-center gap-1.5">
                <i class="fas fa-arrow-left text-[10px]"></i> Back to REad &amp; GroW
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
    <script>
        // Single script to handle both password toggles
        document.querySelectorAll('.password-toggle-icon').forEach(toggle => {
            toggle.addEventListener('click', function () {
                const icon = this.querySelector('i');
                const targetId = icon.getAttribute('data-target');
                const inputField = document.getElementById(targetId);
                const isHidden = inputField.type === 'password';
                inputField.type = isHidden ? 'text' : 'password';
                icon.classList.toggle('fa-eye', !isHidden);
                icon.classList.toggle('fa-eye-slash', isHidden);
                this.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
            });
        });
    </script>
</body>

</html>
